OPENAI_API_KEY=sk-REEMPLAZA
MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Expense Tracker — genera ambos con (deben ser valores DISTINTOS entre sí):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ver README_expense_tracker.md > "Rotación de secretos"
EXPENSE_TRACKER_WEBHOOK_SECRET=
EXPENSE_TRACKER_APP_TOKEN=

# Taller Mecánico — cifrado de PII en clientes. Deben ser DISTINTAS entre
# sí (una rompe reversibilidad si se pierde, la otra rompe la búsqueda por
# teléfono si cambia). Ver README_taller_mecanico.md > "Cifrado de PII".
#   Fernet:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   HMAC:    python -c "import secrets; print(secrets.token_urlsafe(32))"
TALLER_MECANICO_FERNET_KEY=
TALLER_MECANICO_HMAC_KEY=

# Lead Capture Agent — observabilidad Langfuse. Dueño original de estas
# tres variables (ver README_lead_capture_agent.md > "LLM Observability
# with Langfuse"); Taller Mecánico las REUTILIZA como servicio externo
# compartido (mismo Langfuse, no hace falta un LANGFUSE_HOST propio de
# cada agente) con su propio interruptor de opt-in, ver más abajo. Sin
# estas tres, ninguno de los dos agentes traza -- ambos siguen
# funcionando igual, solo sin observabilidad.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Taller Mecánico — interruptor PROPIO, además de las tres variables de
# arriba (que son de Lead Capture). Sin esto en "1", taller_mecanico NO
# activa Langfuse aunque esas tres ya estén puestas para el otro agente
# -- ver README_taller_mecanico.md > "Observabilidad con Langfuse".
TALLER_MECANICO_LANGFUSE_ENABLED=
